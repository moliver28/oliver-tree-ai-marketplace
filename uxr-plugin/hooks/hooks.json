{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch.py sessionstart\" || python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch.py sessionstart\" || exit 0",
            "timeout": 20
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/session_logger.py\" || python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/session_logger.py\" || exit 0",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch.py subagentstop\" || python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch.py subagentstop\" || exit 0",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/review_gate.py\" || python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/review_gate.py\" || exit 0",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/analytics.py\" || python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/analytics.py\" || exit 0",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch.py stop\" || python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch.py stop\" || exit 0",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/analytics.py\" || python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/analytics.py\" || exit 0",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
