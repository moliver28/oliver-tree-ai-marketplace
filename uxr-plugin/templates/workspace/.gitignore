# Participant data never enters version control (fail closed: the
# gitignore gate blocks any write when these are not ignored).
interviews/participant-key.md
interviews/raw-transcripts/

# Session briefs hold workspace-scoped drafts; the journal keeps its own
# copies.
.sessions/gather-brief-*.md
.sessions/deck-collect-brief-*.md

# Session records carry local transcript paths and machine details; the
# state journal keeps the canonical copy.
.sessions/*.json
provenance.jsonl
sources-index.json

# Deck working files (rqs, beats, outline, collect brief) and generated
# .pptx decks are regenerable artifacts; never committed.
deck/
deliverables/*.pptx

# Secrets never land here.
.env
.env.local

# Media files are large binaries; keep them out of the repo.
*.mp4
*.wav
*.mp3
*.zip

# Editor and OS noise.
.DS_Store
Thumbs.db
*.swp
*~
