{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://moliver28.github.io/uxr-plugin/references/review-flags.schema.json",
  "title": "Synthetic reader review flags and writer edit log (issue 11)",
  "description": "Validates the two JSON surfaces of the interview-script review loop: a reader flag array (bare JSON array, expert-participant or novice-participant) and a script-writer edit log (bare array or an object wrapping flags and edits). Reader output is a bare array; the writer appends a fenced JSON edit log after the full script.",
  "anyOf": [
    { "$ref": "#/definitions/flag_array" },
    { "$ref": "#/definitions/edit_array" },
    {
      "type": "object",
      "properties": {
        "flags": { "$ref": "#/definitions/flag_array" },
        "edits": { "$ref": "#/definitions/edit_array" }
      },
      "additionalProperties": false,
      "minProperties": 1
    }
  ],
  "definitions": {
    "flag_id": { "type": "string", "minLength": 1 },
    "flag_array": {
      "type": "array",
      "items": { "$ref": "#/definitions/flag" }
    },
    "edit_array": {
      "type": "array",
      "items": { "$ref": "#/definitions/edit" }
    },
    "flag": {
      "type": "object",
      "required": [
        "flag_id",
        "agent",
        "flag_type",
        "severity",
        "section_anchor",
        "quoted_evidence",
        "why",
        "suggested_minimal_fix",
        "synthetic",
        "artifact_grounded",
        "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "flag_id": { "$ref": "#/definitions/flag_id" },
        "agent": {
          "type": "string",
          "enum": ["expert-participant", "novice-participant"]
        },
        "flag_type": {
          "type": "string",
          "enum": [
            "over-explanation",
            "redundant-question",
            "jargon-mismatch",
            "flat-answer-risk",
            "unfamiliar-term",
            "ambiguous-instruction",
            "unexecutable-step",
            "artifact-mismatch"
          ]
        },
        "severity": {
          "type": "string",
          "enum": ["critical", "high", "medium", "low"]
        },
        "section_anchor": { "type": "string", "minLength": 1 },
        "quoted_evidence": { "type": "string", "minLength": 1 },
        "why": { "type": "string", "minLength": 1 },
        "suggested_minimal_fix": { "type": "string", "minLength": 1 },
        "synthetic": { "const": true },
        "artifact_grounded": { "type": "boolean" },
        "confidence": {
          "type": "string",
          "enum": ["asserted", "hedged"]
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["agent"],
            "properties": { "agent": { "const": "expert-participant" } }
          },
          "then": {
            "properties": {
              "flag_type": {
                "enum": [
                  "over-explanation",
                  "redundant-question",
                  "jargon-mismatch",
                  "flat-answer-risk"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": ["agent"],
            "properties": { "agent": { "const": "novice-participant" } }
          },
          "then": {
            "properties": {
              "flag_type": {
                "enum": [
                  "unfamiliar-term",
                  "ambiguous-instruction",
                  "unexecutable-step",
                  "artifact-mismatch"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": ["flag_type"],
            "properties": { "flag_type": { "const": "flat-answer-risk" } }
          },
          "then": {
            "properties": { "confidence": { "const": "hedged" } }
          }
        },
        {
          "if": {
            "required": ["artifact_grounded"],
            "properties": { "artifact_grounded": { "const": true } }
          },
          "then": {
            "required": ["artifact_grounded"],
            "properties": {
              "flag_type": {
                "enum": ["unexecutable-step", "artifact-mismatch"]
              }
            }
          }
        }
      ]
    },
    "edit": {
      "type": "object",
      "required": [
        "edit_id",
        "resolves_flag_ids",
        "section_anchor",
        "before_text",
        "after_text",
        "edit_kind",
        "hard_rule_preserved"
      ],
      "additionalProperties": false,
      "properties": {
        "edit_id": { "type": "string", "minLength": 1 },
        "resolves_flag_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "section_anchor": { "type": "string", "minLength": 1 },
        "before_text": { "type": "string" },
        "after_text": { "type": "string" },
        "edit_kind": {
          "type": "string",
          "enum": [
            "word-swap",
            "phrase-swap",
            "sentence-rewrite",
            "question-replace",
            "probe-add"
          ]
        },
        "hard_rule_preserved": {
          "type": "string",
          "enum": [
            "no-yes-no",
            "word-cap",
            "no-em-dash",
            "rq-coverage",
            "time-math",
            "structure-invariant"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["edit_kind"],
            "properties": { "edit_kind": { "const": "probe-add" } }
          },
          "then": {
            "required": ["resolves_flag_ids"],
            "properties": {
              "resolves_flag_ids": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
